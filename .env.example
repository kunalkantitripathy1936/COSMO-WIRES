# NASA_API_KEY: Optional NASA Open APIs key for Astronomy Picture of the Day (APOD).
# Defaults to NASA's public DEMO_KEY if not provided.
NASA_API_KEY="DEMO_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, sitemaps, and canonical URLs.
APP_URL="MY_APP_URL"

# NEWS_REFRESH_INTERVAL_MINUTES: Optional background RSS/API refresh interval (5-60 minutes, default 15).
NEWS_REFRESH_INTERVAL_MINUTES="15"

# Optional Frontend API Base URL (client-visible — NEVER put secrets in VITE_* variables).
# Leave unset on Vercel or when serving via server.ts so requests go directly to same-origin /api/*.
# Set only if intentionally deploying the API on a separate external domain (e.g. https://api.cosmowires.com).
# VITE_API_BASE_URL=""

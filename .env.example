# GEMINI_API_KEY: Required for Gemini AI API calls (Cosmic Explainer).
# Configure in Vercel Project Settings > Environment Variables (or AI Studio Secrets).
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Optional model overrides (defaults: primary gemini-4-hydrogen, fallback gemini-3.1-flash-lite).
# GEMINI_PRIMARY_MODEL="gemini-4-hydrogen"
# GEMINI_FALLBACK_MODEL="gemini-3.1-flash-lite"

# NASA_API_KEY: Optional NASA Open APIs key for Astronomy Picture of the Day (APOD).
# Defaults to NASA's public DEMO_KEY if not provided.
NASA_API_KEY="DEMO_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, sitemaps, and canonical URLs.
APP_URL="MY_APP_URL"

# NEWS_REFRESH_INTERVAL_MINUTES: Optional background RSS/API refresh interval (5-60 minutes, default 15).
NEWS_REFRESH_INTERVAL_MINUTES="15"

# Contact Us Email Delivery (Server-Side Only — NEVER expose in client code)
# Destination inbox for Contact Us submissions (defaults to cosmowires.connect@gmail.com).
CONTACT_TO_EMAIL="cosmowires.connect@gmail.com"

# Option A — Gmail SMTP configuration (Recommended: use a Google Account 16-character App Password, NOT your regular Gmail password).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-sender-account@gmail.com"
SMTP_PASS="YOUR_16_CHAR_GMAIL_APP_PASSWORD"
# Optional custom From header (defaults to "COSMO WIRES Contact" <SMTP_USER>).
# SMTP_FROM="COSMO WIRES Contact <your-sender-account@gmail.com>"

# Option B — Resend HTTP API (used automatically if SMTP_USER/SMTP_PASS are not set).
# RESEND_API_KEY="re_your_api_key"
# RESEND_FROM="COSMO WIRES <contact@yourdomain.com>"

# Optional Frontend API Base URL (client-visible — NEVER put secrets in VITE_* variables).
# Leave unset on Vercel or when serving via server.ts so requests go directly to same-origin /api/*.
# Set only if intentionally deploying the API on a separate external domain (e.g. https://api.cosmowires.com).
# VITE_API_BASE_URL=""


